# Configuração pública do projeto Firebase (segura para o navegador)
NEXT_PUBLIC_FIREBASE_API_KEY=chave-desenvolvimento-local
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-fluxo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-fluxo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-fluxo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:000000000000

# Conectores locais do Firebase Emulator Suite ("true" em desenvolvimento local)
NEXT_PUBLIC_USAR_EMULADORES=true
NEXT_PUBLIC_URL_BASE_PUBLICA=http://localhost:3000

# Segredos exclusivos de servidor / Cloud Functions (NUNCA usar prefixo NEXT_PUBLIC_)
# Em produção, gerenciados pelo Google Cloud Secret Manager / Firebase App Hosting Secrets:
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# RESEND_API_KEY=
# GOOGLE_PLACES_API_KEY= (segredo das Cloud Functions; Places API (New))

