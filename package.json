{
  "name": "nexo-ativo",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS brasileiro de presença digital editorial premium com microfluxos comerciais interativos",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "emuladores": "firebase emulators:start --project demo-fluxo --import ./dados-emulador --export-on-exit ./dados-emulador",
    "emuladores:salvar": "firebase emulators:export ./dados-emulador --project demo-fluxo --force",
    "recuperar:garage88": "vite-node --config vitest.config.ts scripts/recuperarGarage88.ts",
    "provisionar:fundador": "vite-node --config vitest.config.ts scripts/provisionarFundador.ts",
    "promover:organizacao": "vite-node --config vitest.config.ts scripts/promoverOrganizacaoProducao.ts",
    "atualizar:chamadas-garage88": "vite-node --config vitest.config.ts scripts/atualizarChamadasGarage88.ts",
    "build": "next build",
    "iniciar": "next start",
    "verificar-tipos": "tsc --noEmit && npm --prefix funcoes run verificar-tipos",
    "lint": "eslint src testes funcoes/src",
    "formatar": "prettier --write .",
    "formatar:verificar": "prettier --check .",
    "testar": "vitest run",
    "testar:conexoes-editor": "node scripts/verificarConexoesEditor.mjs",
    "testar:regras": "firebase emulators:exec --project demo-fluxo-regras --only firestore \"vitest run --config vitest.regras.config.ts\"",
    "testar:observar": "vitest",
    "funcoes:build": "npm --prefix funcoes run build",
    "atualizar:microfluxos-garage88": "vite-node --config vitest.config.ts scripts/atualizarMicrofluxosGarage88.ts"
  },
  "dependencies": {
    "@fontsource-variable/cormorant": "^5.2.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@xyflow/react": "^12.12.1",
    "clsx": "^2.1.1",
    "firebase": "^11.4.0",
    "firebase-admin": "^13.2.0",
    "lucide-react": "^0.487.0",
    "motion": "^12.6.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.1"
  }
}
